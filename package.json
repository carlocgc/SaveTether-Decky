{
  "name": "savetether-decky",
  "version": "0.0.1",
  "description": "Decky plugin that shows the health of SaveTether's save folder links in Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit --skipLibCheck && node --test \"tests/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlocgc/SaveTether-Decky.git"
  },
  "keywords": ["decky", "plugin", "steam-deck", "saves"],
  "author": "SaveTether contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carlocgc/SaveTether-Decky/issues"
  },
  "homepage": "https://github.com/carlocgc/SaveTether-Decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
